{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(node .claude/skills/*/scripts/*)"
    ],
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(gh release create:*)",
      "Bash(git push origin v*)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git add -A *)",
      "Bash(git add --all *)",
      "Bash(git add . *)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n)",
      "Bash(git commit * -n *)",
      "Bash(git reset *--hard*)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout * -- *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Read(.env.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*push*)",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/skills/dev-init/scripts/guard-push.mjs"
            ]
          },
          {
            "type": "command",
            "if": "PowerShell(*push*)",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/skills/dev-init/scripts/guard-push.mjs"
            ]
          }
        ]
      }
    ]
  }
}
